    },
    {
      "title": "超时与一星评价",
      "metric": "46.1% / 6.6%",
      "detail": "超时订单一星占比约 46.1%；按时/提前送达订单一星占比约 6.6%。"
    },
    {
      "title": "州级成交集中度",
      "metric": "SP 38.3%",
      "detail": "成交额最高的州为 SP，约占全部已送达成交额的 38.3%。"
    },
    {
      "title": "品类与卖家集中度",
      "metric": "Top5 39.8%",
      "detail": "成交额前 5 品类合计约占 39.8%；按成交额累计，约 533 名卖家贡献 80% 成交额（卖家总数 2,970）。"
    }
  ],
